<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taha_clinical_patient_tree" model="ir.ui.view">
        <field name="name">taha.clinical.patient.tree</field>
        <field name="model">taha.clinical.patient</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="occupation"/>
                <field name="city"/>
                <field name="region"/>
                <field name="diagnosis_count"/>
            </tree>
        </field>
    </record>

    <record id="view_taha_clinical_patient_form" model="ir.ui.view">
        <field name="name">taha.clinical.patient.form</field>
        <field name="model">taha.clinical.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_diagnoses" type="object"
                                class="oe_stat_button" icon="fa-stethoscope">
                            <field name="diagnosis_count" widget="statinfo" string="Diagnoses"/>
                        </button>
                    </div>
                    <group>
                        <group string="Identity (local only, never synced)">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="national_id"/>
                            <field name="street"/>
                            <field name="date_of_birth"/>
                        </group>
                        <group string="Allowed epidemiological fields">
                            <field name="occupation"/>
                            <field name="city"/>
                            <field name="district"/>
                            <field name="region"/>
                        </group>
                    </group>
                    <field name="diagnosis_ids" readonly="1">
                        <tree>
                            <field name="diagnosed_at"/>
                            <field name="diagnosis_code"/>
                            <field name="diagnosis_name"/>
                            <field name="sync_status"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_taha_clinical_patient_search" model="ir.ui.view">
        <field name="name">taha.clinical.patient.search</field>
        <field name="model">taha.clinical.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="occupation"/>
                <field name="city"/>
                <field name="region"/>
            </search>
        </field>
    </record>

    <record id="action_taha_clinical_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">taha.clinical.patient</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a clinic patient</p>
            <p>Names, phones, national IDs and street addresses stay in this Odoo database.</p>
        </field>
    </record>

    <record id="view_taha_clinical_diagnosis_tree" model="ir.ui.view">
        <field name="name">taha.clinical.diagnosis.tree</field>
        <field name="model">taha.clinical.diagnosis</field>
        <field name="arch" type="xml">
            <tree>
                <field name="diagnosed_at"/>
                <field name="patient_id"/>
                <field name="diagnosis_code"/>
                <field name="diagnosis_name"/>
                <field name="patient_occupation"/>
                <field name="patient_region"/>
                <field name="sync_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_taha_clinical_diagnosis_form" model="ir.ui.view">
        <field name="name">taha.clinical.diagnosis.form</field>
        <field name="model">taha.clinical.diagnosis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Clinical record">
                            <field name="patient_id"/>
                            <field name="diagnosis_code"/>
                            <field name="diagnosis_name"/>
                            <field name="diagnosed_at"/>
                            <field name="sync_status"/>
                            <field name="last_queue_id" readonly="1"/>
                        </group>
                        <group string="Synced demographic snapshot">
                            <field name="patient_occupation"/>
                            <field name="patient_city"/>
                            <field name="patient_region"/>
                        </group>
                    </group>
                    <field name="clinical_notes" placeholder="Clinical notes remain in this clinic. They are never transmitted."/>
                    <field name="queue_ids" readonly="1">
                        <tree>
                            <field name="create_date"/>
                            <field name="event_id"/>
                            <field name="status"/>
                            <field name="attempts"/>
                            <field name="last_error"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_taha_clinical_diagnosis_search" model="ir.ui.view">
        <field name="name">taha.clinical.diagnosis.search</field>
        <field name="model">taha.clinical.diagnosis</field>
        <field name="arch" type="xml">
            <search>
                <field name="diagnosis_code"/>
                <field name="diagnosis_name"/>
                <field name="patient_id"/>
                <filter string="Not synced" name="not_synced" domain="[('sync_status', 'in', ['pending', 'failed'])]"/>
                <group>
                    <filter string="Disease" name="group_disease" context="{'group_by': 'diagnosis_name'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'sync_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_taha_clinical_diagnosis" model="ir.actions.act_window">
        <field name="name">Diagnoses</field>
        <field name="res_model">taha.clinical.diagnosis</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_not_synced': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log a diagnosis</p>
            <p>Saving a diagnosis queues an anonymized payload. Patient names and identifiers are stripped first.</p>
        </field>
    </record>

</odoo>
