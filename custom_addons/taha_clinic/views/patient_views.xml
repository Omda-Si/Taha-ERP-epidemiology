<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taha_clinical_patient_form_clinic" model="ir.ui.view">
        <field name="name">taha.clinical.patient.form.clinic</field>
        <field name="model">taha.clinical.patient</field>
        <field name="inherit_id" ref="view_taha_clinical_patient_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                    <field name="appointment_count" widget="statinfo" string="Appointments"/>
                </button>
                <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="file_number"/>
            </xpath>
            <xpath expr="//field[@name='date_of_birth']" position="after">
                <field name="blood_group"/>
                <field name="emergency_contact"/>
                <field name="partner_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_taha_clinical_patient_tree_clinic" model="ir.ui.view">
        <field name="name">taha.clinical.patient.tree.clinic</field>
        <field name="model">taha.clinical.patient</field>
        <field name="inherit_id" ref="view_taha_clinical_patient_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="file_number"/>
            </xpath>
        </field>
    </record>
</odoo>
