<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_taha_clinic" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.taha.clinic</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Taha Clinic" string="Taha Clinic" name="taha_clinic" groups="taha_clinic.group_manager">
                    <block title="Appointments" name="taha_clinic_block">
                        <setting string="Default appointment length">
                            <field name="taha_clinic_default_duration"/>
                        </setting>
                    </block>
                    <block title="Taha Group epidemiology sync" name="taha_clinic_epi_block">
                        <setting string="Enable sync" help="When off, diagnoses stay in the local queue and are not sent.">
                            <field name="taha_epi_sync_enabled"/>
                        </setting>
                        <setting string="HQ API URL" help="Base URL of Taha HQ Odoo or the cloud API. Do not add /api/v1/...">
                            <field name="taha_epi_api_url" placeholder="http://127.0.0.1:8069"/>
                        </setting>
                        <setting string="Secret access token">
                            <field name="taha_epi_api_token" password="True"/>
                        </setting>
                        <setting string="HMAC signing secret">
                            <field name="taha_epi_hmac_secret" password="True"/>
                        </setting>
                        <setting string="Facility code">
                            <field name="taha_epi_facility_code" placeholder="CLN-KRT-001"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_taha_clinic_config" model="ir.actions.act_window">
        <field name="name">Clinic settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="base.res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'taha_clinic'}</field>
    </record>
</odoo>
