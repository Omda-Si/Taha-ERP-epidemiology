<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taha_clinic_dashboard_form" model="ir.ui.view">
        <field name="name">taha.clinic.dashboard.form</field>
        <field name="model">taha.clinic.dashboard</field>
        <field name="arch" type="xml">
            <form string="Clinic dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Clinic operations</h1>
                        <p>Reception, waiting room, consultations and unpaid invoices for today.</p>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_today" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_today" widget="statinfo" string="Today"/>
                        </button>
                        <button name="action_open_waiting" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="waiting_count" widget="statinfo" string="Waiting"/>
                        </button>
                        <button name="action_open_consult" type="object" class="oe_stat_button" icon="fa-stethoscope">
                            <field name="in_consult_count" widget="statinfo" string="In consult"/>
                        </button>
                        <button name="action_open_unpaid" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="unpaid_invoices" widget="statinfo" string="Unpaid"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="new_patients_today"/>
                            <field name="revenue_today"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_taha_clinic_dashboard" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_taha_clinic_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>
</odoo>
