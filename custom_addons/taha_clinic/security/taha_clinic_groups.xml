<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_taha_clinic" model="ir.module.category">
        <field name="name">Taha Clinic</field>
        <field name="sequence">38</field>
    </record>

    <record id="group_receptionist" model="res.groups">
        <field name="name">Reception</field>
        <field name="category_id" ref="module_category_taha_clinic"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Register patients, book appointments, and check patients in.</field>
    </record>

    <record id="group_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="category_id" ref="module_category_taha_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_receptionist'))]"/>
        <field name="comment">Consult, prescribe, and record diagnoses.</field>
    </record>

    <record id="group_billing" model="res.groups">
        <field name="name">Billing</field>
        <field name="category_id" ref="module_category_taha_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_receptionist')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Create consultation invoices and register payments.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_taha_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_doctor')), (4, ref('group_billing'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
