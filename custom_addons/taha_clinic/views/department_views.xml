<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taha_clinic_department_tree" model="ir.ui.view">
        <field name="name">taha.clinic.department.tree</field>
        <field name="model">taha.clinic.department</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_taha_clinic_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">taha.clinic.department</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
