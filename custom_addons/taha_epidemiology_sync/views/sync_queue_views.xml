<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taha_epi_sync_queue_tree" model="ir.ui.view">
        <field name="name">taha.epi.sync.queue.tree</field>
        <field name="model">taha.epi.sync.queue</field>
        <field name="arch" type="xml">
            <tree decoration-success="status == 'synced'" decoration-danger="status == 'rejected'" decoration-warning="status == 'failed'">
                <field name="create_date"/>
                <field name="event_id"/>
                <field name="diagnosis_id"/>
                <field name="status" widget="badge"/>
                <field name="attempts"/>
                <field name="next_retry_at"/>
                <field name="last_error"/>
            </tree>
        </field>
    </record>

    <record id="view_taha_epi_sync_queue_form" model="ir.ui.view">
        <field name="name">taha.epi.sync.queue.form</field>
        <field name="model">taha.epi.sync.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry_now" type="object" string="Retry now"
                            class="oe_highlight" invisible="status == 'synced'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,failed,synced"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="diagnosis_id"/>
                            <field name="attempts"/>
                            <field name="next_retry_at"/>
                        </group>
                        <group>
                            <field name="last_attempt_at"/>
                            <field name="synced_at"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <label for="payload_json"/>
                    <field name="payload_json" nolabel="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_taha_epi_sync_queue_search" model="ir.ui.view">
        <field name="name">taha.epi.sync.queue.search</field>
        <field name="model">taha.epi.sync.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_id"/>
                <field name="diagnosis_id"/>
                <filter string="Needs attention" name="needs_attention" domain="[('status', 'in', ['pending', 'failed'])]"/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Synced" name="synced" domain="[('status', '=', 'synced')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_taha_epi_sync_queue" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">taha.epi.sync.queue</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_needs_attention': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No queued payloads</p>
            <p>Anonymized events wait here when the Taha Group server is unreachable, then flush automatically.</p>
        </field>
    </record>

    <menuitem id="menu_taha_epi_sync_queue" name="Sync Queue" parent="menu_taha_epi_root"
              action="action_taha_epi_sync_queue" sequence="30"
              groups="taha_epidemiology_sync.group_manager"/>
</odoo>
