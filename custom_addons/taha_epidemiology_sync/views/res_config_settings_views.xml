<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_taha_epi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.taha.epidemiology</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Taha Epidemiology" string="Taha Epidemiology" name="taha_epidemiology_sync" groups="taha_epidemiology_sync.group_manager">
                    <block title="Central Cloud API" name="taha_epi_cloud_block">
                        <setting id="taha_epi_sync_enabled_setting" string="Enable sync" help="When disabled, diagnoses are still anonymized and queued locally but nothing is transmitted.">
                            <field name="taha_epi_sync_enabled"/>
                        </setting>
                        <setting id="taha_epi_api_url_setting" string="API endpoint URL" help="HTTPS URL of the Taha Group ingest server, without a trailing slash.">
                            <field name="taha_epi_api_url" placeholder="https://epi.tahagroup.example"/>
                        </setting>
                        <setting id="taha_epi_api_token_setting" string="Secret access token" help="Bearer token issued by Taha Group. Never include patient identifiers in this token.">
                            <field name="taha_epi_api_token" password="True"/>
                        </setting>
                        <setting id="taha_epi_hmac_secret_setting" string="HMAC signing secret" help="Optional shared secret used to sign the JSON body as X-Taha-Signature.">
                            <field name="taha_epi_hmac_secret" password="True"/>
                        </setting>
                        <setting id="taha_epi_facility_code_setting" string="Facility code" help="Public clinic identifier sent with each anonymized event. Do not use a patient or medical-record number.">
                            <field name="taha_epi_facility_code" placeholder="CLN-KRT-001"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_taha_epi_config_settings" model="ir.actions.act_window">
        <field name="name">Taha Epidemiology Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="base.res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'taha_epidemiology_sync'}</field>
    </record>

    <menuitem id="menu_taha_epi_config" name="Settings" parent="menu_taha_epi_root"
              action="action_taha_epi_config_settings" sequence="90"
              groups="taha_epidemiology_sync.group_manager"/>
</odoo>
