<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taha_clinic_doctor_tree" model="ir.ui.view">
        <field name="name">taha.clinic.doctor.tree</field>
        <field name="model">taha.clinic.doctor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="specialty"/>
                <field name="department_id"/>
                <field name="consultation_fee"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="view_taha_clinic_doctor_form" model="ir.ui.view">
        <field name="name">taha.clinic.doctor.form</field>
        <field name="model">taha.clinic.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="department_id"/>
                            <field name="license_no"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="consultation_fee"/>
                            <field name="consultation_product_id"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_taha_clinic_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">taha.clinic.doctor</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
