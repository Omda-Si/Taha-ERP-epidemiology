<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_taha_epidemiology" model="ir.module.category">
        <field name="name">Taha Epidemiology</field>
        <field name="description">Anonymized epidemiological data sync</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_taha_epidemiology"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Log local patients and diagnoses. Cannot change central API credentials.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_taha_epidemiology"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure the Taha Group API endpoint and review the sync queue.</field>
    </record>
</odoo>
