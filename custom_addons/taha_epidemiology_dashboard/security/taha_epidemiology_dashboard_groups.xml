<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_taha_epi_dashboard" model="ir.module.category">
        <field name="name">Taha Epidemiology HQ</field>
        <field name="sequence">39</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Analyst</field>
        <field name="category_id" ref="module_category_taha_epi_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">View anonymized outbreak reports.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_taha_epi_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure ingest credentials and review all reports.</field>
    </record>
</odoo>
