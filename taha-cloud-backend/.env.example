# PostgreSQL or Supabase connection string
# Supabase: Project Settings → Database → URI (use the session/pooler URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Required. Clinics send this as: Authorization: Bearer <token>
# or as: X-API-Key: <token>
TAHA_API_TOKEN=change-me-central-token

# Optional but recommended. When set, the raw JSON body must be signed
# with HMAC-SHA256 in header X-Taha-Signature.
TAHA_HMAC_SECRET=change-me-hmac-secret

HOST=0.0.0.0
PORT=8080
